# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=safehaven

# ---------------------------------------------------------
# Live mode (Supabase). Copy to .env and fill in. Never commit .env.
# Local stack: run `npx supabase start`, then `npx supabase status` for these values.
# Hosted: Supabase dashboard > Project Settings > API.
# ---------------------------------------------------------
# Public: sent to the browser via /app-config.js
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
# SECRET: server only. Bypasses row-level security. Used to send SOS pushes and purge old data.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# ---------------------------------------------------------
# Web Push for SOS alerts. Generate a pair with: npm run vapid
# ---------------------------------------------------------
VAPID_PUBLIC_KEY=<vapid-public-key>
# SECRET: server only
VAPID_PRIVATE_KEY=<vapid-private-key>
# A contact for push services: mailto: address or https URL you control
VAPID_SUBJECT=mailto:<you@example.com>

# ---------------------------------------------------------
# Map tiles for live mode (optional). Defaults to OpenStreetMap's public tiles,
# which have a usage policy (https://operations.osmfoundation.org/policies/tiles/)
# that rules out heavy production traffic. Use a tile provider for production.
# ---------------------------------------------------------
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# PORT=3000
